# 관리 화면 (/admin) 및 dev API — 로컬 전용
VITE_ADMIN_ENABLED=true

# 선택: 비우거나 줄 삭제 시 PIN 없이 관리 가능
VITE_ADMIN_PIN=1234

# 선택: true 이면 보호 모드 강제 ON (주제 목록 스위치 비활성)
# UI 토글만 쓸 경우 생략 — /admin/topics 관리 열 스위치
# VITE_ADMIN_PROTECT=true

# 자연어 주제 등록(/admin/topics/register/nl) — 없으면 빈 템플릿·규칙만
# WIKI_TOPIC_LLM_API_KEY=your-google-ai-key
# WIKI_TOPIC_LLM_MODEL=gemini-2.5-flash
