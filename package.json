{
  "name": "ai-synapse-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:entries": "node scripts/build-entries.mjs",
    "build:export": "node scripts/build-notebooklm-export.mjs",
    "predev": "npm run build:entries",
    "dev": "vite",
    "prebuild": "npm run build:entries && npm run build:export",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run build:entries && vitest run",
    "test:watch": "vitest",
    "notify": "powershell -ExecutionPolicy Bypass -File scripts/notify-complete.ps1",
    "hermes:register": "powershell -ExecutionPolicy Bypass -File scripts/register-hermes.ps1",
    "start": "powershell -ExecutionPolicy Bypass -File scripts/start-dev.ps1"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
}
